<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Julius · {{ r.account_id }} · {{ r.period }}</title>
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { background: #eceee7; color: #1a1e24;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    -webkit-font-smoothing: antialiased; }
  .mono { font-family: ui-monospace, "SF Mono", "Cascadia Code", Consolas, monospace; }
  a { color: #0053b3; text-decoration: none; } a:hover { text-decoration: underline; }
  .wrap { max-width: 1000px; margin: 40px auto; background: #fff; border: 1px solid #d9dcd3;
    box-shadow: 0 1px 0 rgba(0,0,0,.02), 0 24px 60px -30px rgba(20,24,31,.35); }
  h2 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -.01em; color: #12233f; }
  .sec { display: flex; align-items: baseline; gap: 12px; }
  .sec .n { font-size: 12px; font-weight: 600; }
  .lead { margin: 6px 0 0; font-size: 14px; line-height: 1.6; color: #4b5159; max-width: 780px; }
  .chip { display: inline-block; font-size: 11px; font-weight: 600; border-radius: 5px; padding: 3px 8px; }
  .kicker { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: #7c8374; font-weight: 600; }
  .barwrap { height: 7px; border-radius: 4px; background: #eef0ea; position: relative; overflow: hidden; }

  /* Impressão / exportação para PDF (equivale ao "-print" do design) */
  @media print {
    @page { margin: 0.45in; }
    html, body { background: #fff; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .wrap { max-width: none; margin: 0; border: 0; box-shadow: none; }
    h2, .sec { break-after: avoid; }
    /* Não quebrar cartões/linhas no meio da página */
    .barwrap, [style*="border-radius:12px"] { break-inside: avoid; }
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- HEADER BAND -->
  <div style="background:#12233f;color:#f4f5f1;padding:34px 44px 26px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:32px;flex-wrap:wrap;">
      <div style="max-width:560px;">
        <div style="display:flex;align-items:center;gap:12px;">
          {% if avatar %}<img src="{{ avatar }}" alt="Julius" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid #e8730c;box-shadow:0 2px 8px rgba(0,0,0,.3);">{% endif %}
          <span style="font-weight:700;font-size:26px;letter-spacing:-.01em;">Julius</span>
          <span class="mono" style="font-size:11px;color:#8792a8;border:1px solid #2f4468;border-radius:4px;padding:2px 7px;">v{{ manifest_version }}</span>
        </div>
        <div style="margin-top:14px;font-size:14px;line-height:1.55;color:#b6bece;">Onde a plataforma está gastando mais do que precisa, e o que fazer a respeito. Cada item traz o problema, a ação e quanto ela economiza.</div>
      </div>
      <div class="mono" style="display:grid;grid-template-columns:auto auto;gap:6px 20px;font-size:12px;">
        <span style="color:#7b8498;">conta</span><span style="color:#e6e8e0;text-align:right;">{{ r.account_id }}</span>
        <span style="color:#7b8498;">período</span><span style="color:#e6e8e0;text-align:right;">{{ r.period }}</span>
        <span style="color:#7b8498;">janela</span><span style="color:#e6e8e0;text-align:right;">{{ r.lookback }}</span>
      </div>
    </div>

  </div>

  <!-- O NÚMERO QUE LIDERA, E O RESTO COMO APOIO -->
  <div style="padding:30px 44px 26px;border-bottom:1px solid #e2e4dc;">
    <div class="kicker">Economia identificada por mês</div>
    <div style="margin-top:6px;font-size:52px;line-height:1.05;font-weight:700;color:#e8730c;letter-spacing:-.025em;">{{ r.identified_fmt }}</div>
    <div style="margin-top:6px;font-size:14px;color:#4b5159;max-width:640px;line-height:1.5;">{{ r.recommendation }}</div>
    <div style="margin-top:22px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;max-width:720px;">
      <div>
        <div class="kicker">Até dezembro</div>
        <div style="margin-top:4px;font-size:21px;font-weight:600;color:#12233f;">{{ r.realizable_year_fmt }}</div>
        <div style="margin-top:2px;font-size:11.5px;color:#8a9082;">{{ r.months_remaining }} meses restantes</div>
      </div>
      <div>
        <div class="kicker">Ações recomendadas</div>
        <div style="margin-top:4px;font-size:21px;font-weight:600;color:#12233f;">{{ r.kpi_total }}</div>
        <div style="margin-top:2px;font-size:11.5px;color:#8a9082;">{{ r.pareto_count }} concentram {{ r.pareto_pct }}% do ganho</div>
      </div>
      <div>
        <div class="kicker">Custo da conta no mês</div>
        <div style="margin-top:4px;font-size:21px;font-weight:600;color:#12233f;">{{ r.total_cost_fmt }}</div>
        <div style="margin-top:2px;font-size:11.5px;color:#8a9082;">a economia equivale a {{ r.account_saving_pct }}</div>
      </div>
    </div>
  </div>

  <div style="padding:34px 44px 44px;">

    {% if r.ai_summary %}
    <div style="border:1px solid #cdd9ea;background:#f4f7fb;border-radius:10px;padding:16px 18px;margin-bottom:30px;">
      <span class="kicker" style="color:#0053b3;">Análise contextual pelo Devin</span>
      <div style="margin-top:6px;font-size:14px;line-height:1.55;color:#3a3f46;">{{ r.ai_summary }}</div>
      <div style="margin-top:12px;display:flex;gap:7px;flex-wrap:wrap;">
        {% for item in r.ai_implementation_order %}
        <span class="chip mono" style="color:#0053b3;background:#e6effa;">{{ item.position }} · {{ item.title }}</span>
        {% endfor %}
      </div>
      {% if r.ai_coverage %}
      <div style="margin-top:10px;font-size:11.5px;color:#4b5159;">Cobertura: {{ r.ai_coverage.analyzed }} de {{ r.ai_coverage.total }} oportunidades receberam análise contextual{% if r.ai_coverage.analyzed < r.ai_coverage.total %}; as demais permanecem apenas com a análise determinística{% endif %}.</div>
      {% endif %}
      <div style="margin-top:10px;font-size:11px;color:#7d8795;">A IA adiciona contexto, sequência e documentação; economia, dificuldade, confiança e prioridades permanecem determinísticas.</div>
    </div>
    {% endif %}

    <!-- O QUE FAZER -->
    <div class="sec" style="margin-top:40px;"><span class="n mono" style="color:#e8730c;">01</span><h2>O que fazer, em ordem</h2></div>
    <p class="lead">Cada item diz o problema encontrado e a ação que resolve. A ordem já é a de prioridade — comece pelo topo. Abra “ver detalhes” quando precisar da evidência ou de como conferir o resultado.</p>

    {% if r.pareto_count %}
    <div style="margin-top:18px;border:1px solid #f1e2ce;background:#fef7ef;border-radius:10px;padding:14px 18px;">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:14px;flex-wrap:wrap;">
        <span style="font-size:13.5px;color:#3a3f46;">As <b>{{ r.pareto_count }}</b> ações marcadas com <span class="chip" style="color:#8a3b12;background:#fdefdd;">foco</span> concentram a maior parte da economia.</span>
        <span class="mono" style="font-size:13px;font-weight:600;color:#e8730c;">{{ r.pareto_pct }}% · {{ r.pareto_sum_fmt }}/mês</span>
      </div>
      <div style="margin-top:10px;height:10px;border-radius:5px;background:#f6e6d3;overflow:hidden;">
        <div style="height:100%;width:{{ r.pareto_pct }}%;border-radius:5px;background:#e8730c;"></div>
      </div>
      <div style="margin-top:8px;font-size:11.5px;color:#8a6a4a;">De {{ r.kpi_total }} oportunidades no total. Resolver as de foco entrega quase todo o ganho.</div>
    </div>
    {% endif %}

    <div style="margin-top:20px;display:flex;flex-direction:column;gap:12px;">
      {% for o in r.table %}
      <div style="border:1px solid {% if o.id in r.focus_ids %}#f1d9bd{% else %}#e2e4dc{% endif %};border-radius:12px;overflow:hidden;background:#fff;">
        <div style="display:grid;grid-template-columns:1fr auto;gap:18px;padding:18px 22px;align-items:start;">
          <div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px;">
              <span class="mono" style="font-size:11px;font-weight:700;color:#8a9082;">{{ loop.index }}</span>
              {% if o.id in r.focus_ids %}<span class="chip" style="color:#8a3b12;background:#fdefdd;">foco</span>{% endif %}
              <span class="chip" style="color:{{ o.category_fg }};background:{{ o.category_bg }};">{{ o.category_label }}</span>
              {% if o.bucket == "investigar_primeiro" %}<span class="chip" style="color:#8a6a2a;background:#faf0dd;">precisa investigar antes</span>{% endif %}
              {% if o.origin == "ai_confirmed" %}<span class="chip" style="color:#0053b3;background:#e6effa;">confirmado na análise de código</span>{% endif %}
            </div>
            <div style="font-size:16px;font-weight:600;color:#12233f;line-height:1.35;">{{ o.title }}</div>
            <div style="margin-top:7px;font-size:13.5px;line-height:1.55;color:#4b5159;">{{ o.why }}</div>
            <div style="margin-top:12px;padding:11px 14px;background:#f7f8f4;border-left:3px solid #e8730c;border-radius:0 7px 7px 0;">
              <div class="kicker" style="color:#a5581a;">O que fazer</div>
              <div style="margin-top:4px;font-size:14px;line-height:1.5;color:#22262c;">{{ o.action }}</div>
            </div>
            <div class="mono" style="margin-top:10px;font-size:11.5px;color:#7c8374;">{{ o.asset }}{% if o.owner and o.owner != "—" %} · responsável: {{ o.owner }}{% endif %}</div>
          </div>

          <div style="text-align:right;white-space:nowrap;min-width:150px;">
            {% if o.is_strategic %}
            <div style="font-size:13px;font-weight:600;color:#0053b3;">Ganho estratégico</div>
            <div style="margin-top:3px;font-size:11.5px;color:#8a9082;">sem valor financeiro direto</div>
            {% elif o.monthly_fmt == "—" %}
            <div style="font-size:13px;font-weight:600;color:#8a6a2a;">Valor a medir</div>
            <div style="margin-top:3px;font-size:11.5px;color:#8a9082;">falta evidência</div>
            {% else %}
            <div style="font-size:26px;font-weight:700;color:#e8730c;letter-spacing:-.02em;">{{ o.monthly_fmt }}</div>
            <div style="font-size:11.5px;color:#8a9082;">por mês</div>
            <div style="margin-top:8px;font-size:12px;color:#5b6169;">{{ o.year_fmt }} até dezembro</div>
            {% endif %}
            <div style="margin-top:12px;display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap;">
              <span class="chip" style="color:{{ o.conf_fg }};background:{{ o.conf_bg }};">confiança {{ o.confidence_label | lower }}</span>
              <span class="chip" style="color:{{ o.diff_fg }};background:{{ o.diff_bg }};">esforço {{ o.difficulty_label | lower }}</span>
            </div>
            {% if not o.is_strategic and o.monthly_fmt != "—" %}
            {# O quanto confiar no número decide se o analista age hoje ou pede
               mais dado — precisa estar visível, não atrás de um clique. #}
            <div style="margin-top:7px;font-size:11.5px;color:#7c8374;">{% if o.anchored_in_billing %}valor medido na fatura{% else %}valor estimado a partir do consumo{% endif %}</div>
            {% endif %}
          </div>
        </div>

        <details style="border-top:1px solid #edeee8;">
          <summary style="padding:11px 22px;font-size:12.5px;color:#5b6169;cursor:pointer;background:#fbfcfa;">ver detalhes — evidência, como conferir e de onde vem o número</summary>
          <div style="padding:4px 22px 20px;">
            <div style="display:grid;grid-template-columns:1.3fr 1fr;gap:26px;">
              <div>
                <div class="kicker">O que sustenta este achado</div>
                <div style="margin-top:7px;display:flex;flex-direction:column;gap:5px;">
                  {% for e in o.evidence %}<div style="display:flex;gap:8px;align-items:baseline;font-size:13px;color:#3a3f46;line-height:1.45;"><span style="color:#e8730c;font-weight:700;">›</span><span>{{ e }}</span></div>{% endfor %}
                </div>
                {% if o.ai_diagnosis %}
                <div class="kicker" style="margin-top:16px;color:#0053b3;">Leitura do código e do contexto</div>
                <div style="margin-top:6px;font-size:13px;line-height:1.5;color:#3a3f46;">{{ o.ai_diagnosis }}</div>
                {% if o.ai_implementation_steps %}
                <div style="margin-top:9px;font-size:12.5px;color:#4b5159;"><b>Passo a passo sugerido</b>
                  <ol style="margin:5px 0 0;padding-left:20px;">{% for step in o.ai_implementation_steps %}<li style="margin-top:3px;">{{ step }}</li>{% endfor %}</ol>
                </div>
                {% endif %}
                {% if o.ai_conflicts %}<div style="margin-top:8px;font-size:12.5px;color:#b23b3b;"><b>Atenção:</b> {{ o.ai_conflicts | join("; ") }}</div>{% endif %}
                {% endif %}
                {% if o.next_action %}
                <div class="kicker" style="margin-top:16px;color:#8a6a2a;">Antes de agir</div>
                <div style="margin-top:5px;font-size:13px;color:#4b5159;">{{ o.next_action }}</div>
                {% endif %}
              </div>
              <div>
                <div class="kicker">Como aplicar</div>
                <div style="margin-top:5px;font-size:13px;line-height:1.5;color:#3a3f46;">{{ o.how_to_apply }}{% if o.doc_url %} <a href="{{ o.doc_url }}" target="_blank" rel="noopener">documentação AWS ↗</a>{% endif %}</div>
                <div class="kicker" style="margin-top:14px;">Como conferir que funcionou</div>
                <div style="margin-top:5px;font-size:13px;line-height:1.5;color:#3a3f46;">{{ o.how_to_validate }}</div>
                {% if not o.is_strategic and o.monthly_fmt != "—" %}
                <div class="kicker" style="margin-top:14px;">De onde vem o número</div>
                <div style="margin-top:5px;font-size:12.5px;line-height:1.5;color:#4b5159;">Entre {{ o.band_fmt }} por mês. Base de cálculo: {{ o.baseline_fmt }}{% if o.anchored_in_billing %}, vinda da fatura{% else %}, estimada a partir do consumo{% endif %}.</div>
                {% endif %}
                {% if o.source_process %}
                <div class="kicker" style="margin-top:14px;color:#b23b3b;">Processo que gera este custo</div>
                <div style="margin-top:4px;font-size:13px;font-weight:600;color:#b23b3b;">{{ o.source_process }}</div>
                {% endif %}
                <div class="mono" style="margin-top:16px;padding-top:12px;border-top:1px dashed #dfe1d9;font-size:10.5px;color:#a0a69a;line-height:1.5;">{{ o.id }} · qualidade da evidência: {{ o.evidence_quality_label }} · cobertura {{ o.coverage_pct }} · fontes: {{ o.sources }}</div>
              </div>
            </div>
          </div>
        </details>
      </div>
      {% endfor %}
    </div>

    {% if r.ai_signal_verdicts or r.ai_uncovered_findings %}
    <!-- FORA DO CATÁLOGO -->
    <div class="sec" style="margin-top:44px;"><span class="n mono" style="color:#0053b3;">AI</span><h2>Fora do catálogo</h2></div>
    <p class="lead">Observações da análise contextual que <b>não</b> são achados determinísticos: não têm economia calculada e não ocupam posição no ranking. Servem para decidir o que investigar e o que vale virar regra.</p>

    {% if r.ai_signal_verdicts %}
    <div style="margin-top:16px;">
      <div class="kicker" style="color:#0053b3;">Sinais julgados contra o artefato</div>
      <div style="margin-top:10px;display:flex;flex-direction:column;gap:8px;">
        {% for v in r.ai_signal_verdicts %}
        <div style="border:1px solid #e2e4dc;border-radius:9px;padding:12px 15px;">
          <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;">
            <div class="mono" style="font-size:11px;color:#7c8374;">{{ v.rule_id }} · {{ v.asset_name }}</div>
            <span class="chip" style="font-size:9.5px;{% if v.verdict == 'confirmed' %}color:#8a3b12;background:#fdeee0;{% else %}color:#4b5159;background:#eef0ea;{% endif %}">{{ 'confirmado' if v.verdict == 'confirmed' else 'evidência pendente' }}</span>
          </div>
          <div style="margin-top:6px;font-size:13px;line-height:1.5;color:#3a3f46;">{{ v.rationale }}</div>
          <div class="mono" style="margin-top:5px;font-size:9.5px;color:#8a9082;">artefato {{ v.evidence_ref.sha256[:16] }}{% if v.evidence_ref.lines %} · linhas {{ v.evidence_ref.lines | join(", ") }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.ai_uncovered_findings %}
    <div style="margin-top:20px;">
      <div class="kicker" style="color:#0053b3;">Padrões sem regra correspondente</div>
      <p class="lead" style="margin-top:6px;">Candidatos a virar regra determinística depois de revisão humana. Nenhum tem valor financeiro atribuído.</p>
      <div style="margin-top:10px;display:flex;flex-direction:column;gap:8px;">
        {% for u in r.ai_uncovered_findings %}
        <div style="border:1px solid #cdd9ea;background:#f4f7fb;border-radius:9px;padding:12px 15px;">
          <div style="font-size:13.5px;font-weight:600;color:#12233f;">{{ u.title }}</div>
          <div class="mono" style="margin-top:3px;font-size:11px;color:#7c8374;">{{ u.asset_type }} · {{ u.asset_name }} · regra proposta {{ u.proposed_rule_id }}</div>
          <div style="margin-top:6px;font-size:13px;line-height:1.5;color:#3a3f46;">{{ u.why_not_covered }}</div>
          <div style="margin-top:5px;font-size:12px;color:#4b5159;"><b>Base da confiança:</b> {{ u.confidence_basis }}</div>
          <div class="mono" style="margin-top:5px;font-size:9.5px;color:#8a9082;">artefato {{ u.evidence_ref.sha256[:16] }}{% if u.evidence_ref.lines %} · linhas {{ u.evidence_ref.lines | join(", ") }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% endif %}


    <!-- APÊNDICE — o técnico fica disponível, e fora do caminho -->
    <details style="margin-top:44px;border:1px solid #e2e4dc;border-radius:12px;overflow:hidden;">
      <summary style="padding:16px 22px;background:#f7f8f4;cursor:pointer;font-size:14px;font-weight:600;color:#12233f;">
        Detalhamento técnico
        <span style="display:block;margin-top:3px;font-size:12px;font-weight:400;color:#7c8374;">Saúde da coleta, custo por processo, uso do Athena, governança e histórico. Necessário para auditar os números; dispensável para decidir o que fazer.</span>
      </summary>
      <div style="padding:8px 22px 26px;">
    <!-- SAÚDE DA COLETA -->
    <div style="margin-bottom:30px;border:1px solid #e2e4dc;border-radius:12px;overflow:hidden;">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 18px;background:#f7f8f4;flex-wrap:wrap;">
        <div>
          <div class="kicker">Saúde da coleta</div>
          <div style="margin-top:4px;font-size:13px;color:#4b5159;">{{ r.collection_health_summary }}</div>
        </div>
        <span class="chip" style="color:{{ r.collection_status_fg }};background:{{ r.collection_status_bg }};">{{ r.collection_status_label }}</span>
      </div>
      {% if r.collection_health %}
      <div style="display:grid;grid-template-columns:1.2fr 88px 74px 72px 86px 1.5fr;background:#12233f;color:#c2c9d6;font-size:10px;text-transform:uppercase;letter-spacing:.05em;font-weight:600;">
        <div style="padding:10px 14px;">Fonte</div><div style="padding:10px 8px;">Status</div><div style="padding:10px 8px;text-align:right;">Itens</div><div style="padding:10px 8px;text-align:right;">Cobertura</div><div style="padding:10px 8px;text-align:right;">Atualização</div><div style="padding:10px 14px;">Impacto / próxima ação</div>
      </div>
      {% for h in r.collection_health %}
      <div style="display:grid;grid-template-columns:1.2fr 88px 74px 72px 86px 1.5fr;border-top:1px solid #edeee8;align-items:center;font-size:11.5px;">
        <div style="padding:11px 14px;"><b style="color:#12233f;">{{ h.source }}</b><div class="mono" style="margin-top:2px;font-size:9.5px;color:#8a9082;">{{ h.required }} · {{ h.duration }}</div></div>
        <div style="padding:11px 8px;"><span class="chip" style="color:{{ h.status_fg }};background:{{ h.status_bg }};font-size:9.5px;">{{ h.status_label }}</span></div>
        <div class="mono" style="padding:11px 8px;text-align:right;">{{ h.count }}</div>
        <div class="mono" style="padding:11px 8px;text-align:right;">{{ h.coverage }}</div>
        <div class="mono" style="padding:11px 8px;text-align:right;font-size:9.5px;">{{ h.data_through }}</div>
        <div style="padding:11px 14px;color:#4b5159;line-height:1.35;">{{ h.impact }}{% if h.next_action != "—" %}<div style="margin-top:3px;color:#9a5b10;">Próximo: {{ h.next_action }}</div>{% endif %}{% if h.error_category != "—" %}<div class="mono" style="margin-top:3px;font-size:9.5px;color:#8a9082;">{{ h.error_category }}</div>{% endif %}</div>
      </div>
      {% endfor %}
      {% else %}
      <div style="padding:13px 18px;background:#fff8ec;color:#8a5b18;font-size:12px;">Esse arquivo foi produzido sem telemetria por fonte. Os valores podem ser analisados, mas a completude da coleta não pode ser comprovada.</div>
      {% endif %}
      {% if r.inventory_integrity %}
      <div style="padding:13px 18px;border-top:1px solid #edeee8;font-size:12px;line-height:1.5;">
        <b style="color:#12233f;">Integridade do inventário</b>
        <div style="margin-top:3px;color:#7d8795;font-size:11px;">Medem a qualidade da coleta e do processo, não economia — por isso ficam fora do portfólio e do ranking.</div>
        {% for i in r.inventory_integrity %}
        <div style="margin-top:8px;color:#4b5159;"><span class="mono" style="font-size:10px;color:#8a9082;">{{ i.rule_id }}</span> · <b style="color:#12233f;">{{ i.asset }}</b> — {{ i.finding }}<div style="margin-top:2px;color:#9a5b10;">Próximo: {{ i.action }}</div></div>
        {% endfor %}
      </div>
      {% endif %}
      {% if r.rule_families_without_evidence %}
      <div style="padding:13px 18px;border-top:1px solid #edeee8;background:#fff8ec;color:#8a5b18;font-size:12px;line-height:1.5;">
        <b>Famílias de regra sem evidência:</b> nada foi analisado nelas — ausência de achado aqui não significa ausência de problema.
        {% for f in r.rule_families_without_evidence %}
        <div style="margin-top:4px;">{{ f.service }}/{{ f.name }} — {{ f.reason }}</div>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    {% if r.athena_coverage %}
    <!-- ATHENA INTEGRADO -->
    <div class="sec"><span class="n mono" style="color:#e8730c;">A</span><h2>Athena — padrões de query e uso por pessoa</h2></div>
    <p class="lead">Janela {{ r.athena_coverage.window }} · workgroups {{ r.athena_coverage.workgroups }} · custo líquido alocado {{ r.athena_coverage.cost_fmt }} (qualidade: {{ r.athena_coverage.cost_quality }}) · API × CloudWatch {{ r.athena_coverage.ratio }}.</p>
    <div style="margin-top:16px;border:1px solid #e2e4dc;border-radius:10px;overflow:hidden;">
      {% for q in r.athena_queries %}
      <div style="padding:11px 14px;border-top:1px solid #edeee8;font-size:12px;">
        <b class="mono">{{ q.fingerprint }}</b> · {{ q.workgroup }} · {{ q.executions }} execuções / {{ q.active_days }} dias · {{ q.recurrence }} · {{ q.billed_gb }} GB faturáveis · {{ q.cost_fmt }}{% if q.failures %} · {{ q.failures }} falhas/cancelamentos{% endif %} · reuse {{ q.reuse }}{% if q.reuse_eligible %} · {{ q.reuse_eligible }} repetições exatas elegíveis (até {{ q.reuse_avoidable_cost_fmt }} evitável){% endif %}
        <div class="mono" style="margin-top:4px;color:#7c8374;overflow-wrap:anywhere;">{{ q.sql }}</div>
        {% if q.wide_tables or q.full_scan or q.unpartitioned or q.uncompressed or q.projection_candidates %}
        <div style="margin-top:4px;color:#a5581a;">
          {% if q.wide_tables %}wide: {{ q.wide_tables|join(", ") }} · {% endif %}
          {% if q.full_scan %}full scan · {% endif %}
          {% if q.unpartitioned %}sem partição: {{ q.unpartitioned|join(", ") }} · {% endif %}
          {% if q.uncompressed %}sem compressão: {{ q.uncompressed|join(", ") }} · {% endif %}
          {% if q.codecs %}codecs: {{ q.codecs|join(", ") }} · {% endif %}
          {% if q.projection_candidates %}projection candidata: {{ q.projection_candidates|join(", ") }}{% endif %}
        </div>
        {% endif %}
      </div>
      {% else %}<div style="padding:12px 14px;color:#7c8374;">Nenhum padrão coletado na janela.</div>{% endfor %}
    </div>
    {% if r.athena_actors %}
    <div class="kicker" style="margin-top:18px;">Uso interno por pessoa/processo — sem alterar ownership</div>
    <div style="margin-top:8px;display:grid;grid-template-columns:repeat(2,1fr);gap:8px;">
      {% for a in r.athena_actors %}
      <div style="border:1px solid #e2e4dc;border-radius:8px;padding:10px 12px;font-size:12px;">
        <b>{{ a.actor }}</b> <span class="chip" style="background:#eef0ea;color:#5b6169;">{{ a.type }}</span>
        <div style="margin-top:5px;color:#4b5159;">{{ a.queries }} queries · {{ a.active_days }} dias · {{ a.cost_fmt }} · {{ a.recurring }} padrões recorrentes · {{ a.bursts }} bursts</div>
        {% if a.guidance %}<div style="margin-top:5px;color:#a5581a;">Orientação: revisar {{ a.selects_star }} SELECT *, {{ a.full_scans }} full scans, {{ a.unpartitioned }} usos sem partição, {{ a.compression }} achados de compressão, {{ a.projection }} candidatos a projection e {{ a.failures }} falhas.</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if r.athena_gaps %}<div style="margin-top:10px;font-size:11.5px;color:#a07326;"><b>Lacunas:</b> {{ r.athena_gaps | join("; ") }}</div>{% endif %}
    {% endif %}

    <!-- 00 RECONCILIAÇÃO -->
    <div class="sec"><span class="n mono" style="color:#7b8498;">00</span><h2>Custo da conta — reconciliação</h2></div>
    <p class="lead">Dois períodos, que nunca se somam. A <b>cobrança MTD</b> abaixo é o mês-calendário estimado pela AWS em USD — a âncora com a fatura. Tudo o mais nesta análise vem da <b>janela de {{ r.lookback }}</b> de dias UTC completos, idêntica para Glue e Athena. A atribuição por ativo é um modelo baseado no consumo observado (Glue GetJobRuns, bytes Athena) e não é a fatura.</p>
    <div style="margin-top:20px;display:grid;grid-template-columns:250px 1fr;border:1px solid #e2e4dc;border-radius:12px;overflow:hidden;">
      <div style="background:#12233f;color:#f4f5f1;padding:22px 24px;display:flex;flex-direction:column;justify-content:center;">
        <div class="kicker" style="color:#96a0b4;">Cobrança MTD</div>
        <div style="margin-top:6px;font-size:34px;font-weight:700;letter-spacing:-.02em;">{{ r.account_total_fmt }}</div>
        <div class="mono" style="margin-top:2px;font-size:11px;color:#8792a8;">Cost Explorer · {{ r.region }} · {{ r.period }}</div>
        <div style="margin-top:20px;padding-top:16px;border-top:1px solid #2a3c5c;">
          <div style="display:flex;justify-content:space-between;align-items:baseline;">
            <span class="kicker" style="color:#96a0b4;">Economia identificada</span>
            <span style="font-weight:700;font-size:18px;color:#f4a95c;">{{ r.account_saving_pct }}</span>
          </div>
          <div style="margin-top:8px;height:8px;border-radius:4px;background:#1a2c4a;overflow:hidden;"><div style="height:100%;width:{{ r.account_bar_w }};background:#e8730c;"></div></div>
          <div class="mono" style="margin-top:8px;font-size:12px;color:#e6b98d;">{{ r.account_saving_fmt }}/mês de potencial otimizável</div>
        </div>
      </div>
      <div>
        <div style="display:grid;grid-template-columns:1fr 96px 100px;padding:11px 20px;background:#f3f4ee;font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;font-weight:600;color:#7c8374;">
          <div>Serviço · cobrança × economia identificada</div><div style="text-align:right;">Cobrança MTD</div><div style="text-align:right;">Economia/mês</div>
        </div>
        {% for s in r.services %}
        <div style="display:grid;grid-template-columns:1fr 96px 100px;align-items:center;padding:12px 20px;border-top:1px solid #edeee8;">
          <div style="padding-right:18px;">
            <div style="display:flex;justify-content:space-between;align-items:baseline;">
              <span style="font-size:13.5px;font-weight:600;color:#12233f;">{{ s.name }}</span>
              <span class="mono" style="font-size:11px;color:#a07326;">{{ s.pct_opt }} otimizável</span>
            </div>
            <div class="mono" style="margin-top:2px;font-size:11px;color:#8a9082;">{{ s.sub }}</div>
            <div class="barwrap" style="margin-top:7px;">
              <div style="position:absolute;left:0;top:0;height:100%;width:{{ s.bar_base_w }};background:#c2c9d6;"></div>
              <div style="position:absolute;left:0;top:0;height:100%;width:{{ s.bar_save_w }};background:#e8730c;"></div>
            </div>
          </div>
          <div class="mono" style="text-align:right;font-size:13px;color:#3a3f46;">{{ s.cost_fmt }}</div>
          <div class="mono" style="text-align:right;font-size:13px;font-weight:600;color:{{ s.saving_color }};">{{ s.saving_fmt }}</div>
        </div>
        {% endfor %}
      </div>
    </div>

    {% if r.glue_cost %}
    <div style="margin-top:18px;border:1px solid #e2e4dc;border-radius:12px;overflow:hidden;">
      <div style="display:flex;gap:22px;flex-wrap:wrap;padding:11px 16px;background:#f3f4ee;font-size:11.5px;color:#3a3f46;">
        <span>cobrança Glue por usage type: <b>{{ r.glue_cost.cost_fmt }}</b></span>
        <span>qualidade: <b>{{ r.glue_cost.cost_quality }}</b></span>
        <span>métrica: <b>{{ r.glue_cost.cost_metric }}</b></span>
        <span>consumo modelado / cobrança: <b>{{ r.glue_cost.ratio }}</b></span>
        <span>sem rateio: <b>{{ r.glue_cost.unattributed_fmt }}</b></span>
        <span class="mono" style="color:#8a9082;">{{ r.glue_cost.window }}</span>
      </div>
      {% for b in r.glue_cost.buckets %}
      <div style="display:grid;grid-template-columns:1fr 120px;padding:9px 16px;border-top:1px solid #edeee8;align-items:center;">
        <div class="mono" style="font-size:12px;color:#3a3f46;">{{ b.name }}</div>
        <div class="mono" style="text-align:right;font-size:12px;">{{ b.cost_fmt }}</div>
      </div>
      {% endfor %}
      <div class="mono" style="padding:9px 16px;border-top:1px solid #edeee8;font-size:10.5px;color:#8a9082;">O Cost Explorer não expõe dimensão de recurso para Glue: o custo por job é rateio desta cobrança pelas DPU-horas coletadas, não fatura por job.</div>
      {% if r.glue_cost.unknown_usage_types %}<div style="padding:9px 16px;border-top:1px solid #edeee8;font-size:11.5px;color:#a07326;"><b>Usage types não classificados:</b> {{ r.glue_cost.unknown_usage_types | join(", ") }}</div>{% endif %}
      {% if r.glue_cost.gaps %}<div style="padding:9px 16px;border-top:1px solid #edeee8;font-size:11.5px;color:#a07326;"><b>Lacunas:</b> {{ r.glue_cost.gaps | join("; ") }}</div>{% endif %}
    </div>
    {% endif %}

    {% if r.process_costs %}
    <div style="margin-top:18px;border:1px solid #e2e4dc;border-radius:12px;overflow:hidden;">
      <div style="display:grid;grid-template-columns:1.4fr 1fr 96px 96px 90px;padding:11px 16px;background:#f3f4ee;font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;font-weight:600;color:#7c8374;">
        <div>Processo · componentes</div><div>Dono inferido</div><div style="text-align:right;">Modelo na janela</div><div style="text-align:right;">Por mês</div><div style="text-align:right;">Consumo</div>
      </div>
      {% for p in r.process_costs %}
      <div style="display:grid;grid-template-columns:1.4fr 1fr 96px 96px 90px;padding:12px 16px;border-top:1px solid #edeee8;align-items:center;">
        <div><div style="font-size:13px;font-weight:600;color:#12233f;">{{ p.name }}</div><div class="mono" style="font-size:10.5px;color:#8a9082;">{{ p.root_type }} · {{ p.components }} · {{ p.allocation }}</div></div>
        <div><div style="font-size:12px;color:#3a3f46;">{{ p.owner }}</div><div class="mono" style="font-size:10px;color:#8a9082;">{{ p.owner_source }} · {{ p.owner_event_time }}</div></div>
        <div class="mono" style="text-align:right;font-size:12px;">{{ p.cost_window }}</div>
        <div class="mono" style="text-align:right;font-size:12px;font-weight:600;color:#e8730c;">{{ p.cost_monthly }}</div>
        <div class="mono" style="text-align:right;font-size:10.5px;color:#5b6169;">{{ p.dpu_actual }} reportada<br>{{ p.dpu_estimated }} estimada</div>
      </div>
      {% endfor %}
      <div class="mono" style="padding:9px 16px;border-top:1px solid #edeee8;font-size:10.5px;color:#8a9082;">Modelo na janela = consumo reportado/estimado na janela de análise × tarifa USD versionada. Não é a fatura. A coluna por mês converte a janela pelo fator 30,44/dias — não é projeção de fechamento.</div>
      <div style="display:flex;gap:22px;flex-wrap:wrap;padding:11px 16px;border-top:1px solid #edeee8;background:#fbfcfa;font-size:11.5px;color:#3a3f46;">
        <span>modelo atribuído: <b>{{ r.process_cost_attributed_fmt }}</b></span>
        <span>cobrança MTD Glue: <b>{{ r.glue_cost_explorer_fmt }}</b></span>
        <span>diferença: <b>{{ r.process_cost_delta_fmt }}</b></span>
        <span class="mono" style="color:#8a9082;">{{ r.process_reconciliation_note }}</span>
      </div>
    </div>
    {% endif %}

    {% if r.producers %}
    <!-- 06 PRODUCER -->
    <div class="sec" style="margin-top:44px;"><span class="n mono" style="color:#0053b3;">06</span><h2>Candidatos à Producer</h2></div>
    <p class="lead">Dois scores independentes: <b>Candidatura</b> (o processo assumiu perfil de produção?) × <b>Prontidão</b> (é viável migrar agora?). Nunca migramos a conta inteira — apontamos processo, tabela ou produto.</p>
    <div style="margin-top:20px;display:grid;grid-template-columns:1.1fr .9fr;gap:24px;align-items:stretch;">
      <div style="border:1px solid #e2e4dc;border-radius:12px;padding:20px 20px 14px;position:relative;">
        <div style="position:relative;height:320px;margin:6px 0 0 34px;border-left:2px solid #cdd0c8;border-bottom:2px solid #cdd0c8;">
          <div style="position:absolute;left:0;top:0;width:50%;height:50%;background:#f4f7fb;"></div>
          <div style="position:absolute;right:0;top:0;width:50%;height:50%;background:#eef4fb;"></div>
          <div style="position:absolute;left:0;bottom:0;width:50%;height:50%;background:#fbfbf8;"></div>
          <div style="position:absolute;right:0;bottom:0;width:50%;height:50%;background:#fdf6ec;"></div>
          <div style="position:absolute;left:50%;top:0;bottom:0;width:1px;background:#dfe1d9;"></div>
          <div style="position:absolute;top:50%;left:0;right:0;height:1px;background:#dfe1d9;"></div>
          <div style="position:absolute;right:8px;top:6px;font-size:10px;font-weight:700;color:#0053b3;text-align:right;line-height:1.3;">MIGRAR<br><span style="font-weight:500;color:#7d94b8;">alta+alta</span></div>
          <div style="position:absolute;left:8px;top:6px;font-size:10px;font-weight:700;color:#8a6a2a;line-height:1.3;">PREPARAR<br><span style="font-weight:500;color:#b39a68;">plano</span></div>
          <div style="position:absolute;right:8px;bottom:6px;font-size:10px;font-weight:700;color:#e8730c;text-align:right;line-height:1.3;">MONITORAR</div>
          <div style="position:absolute;left:8px;bottom:6px;font-size:10px;font-weight:700;color:#9a9a90;line-height:1.3;">NÃO PRIORIZAR</div>
          {% for p in r.producers %}
          <div title="{{ p.name }}" style="position:absolute;left:{{ p.x }};bottom:{{ p.y }};transform:translate(-50%,50%);width:15px;height:15px;border-radius:50%;background:{{ p.color }};border:2.5px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.2);"></div>
          {% endfor %}
        </div>
        <div class="mono" style="display:flex;justify-content:space-between;margin:8px 0 0 34px;font-size:10.5px;color:#8a9082;"><span>baixa prontidão →</span><span>alta prontidão</span></div>
        <div class="mono" style="position:absolute;left:14px;top:50%;transform:rotate(-90deg);transform-origin:left;font-size:10.5px;color:#8a9082;white-space:nowrap;">candidatura →</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        {% for p in r.producers %}
        <div style="border:1px solid #e2e4dc;border-radius:10px;padding:13px 16px;">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
            <span style="font-size:13.5px;font-weight:600;color:#12233f;">{{ p.name }}</span>
            <span style="width:10px;height:10px;border-radius:50%;background:{{ p.color }};flex-shrink:0;"></span>
          </div>
          <div style="margin-top:9px;display:flex;gap:16px;">
            <div style="flex:1;"><div style="display:flex;justify-content:space-between;font-size:11px;color:#7c8374;"><span>candidatura</span><span class="mono" style="color:#0053b3;font-weight:600;">{{ p.cand }}</span></div>
              <div style="margin-top:3px;height:4px;border-radius:2px;background:#eef0ea;"><div style="height:100%;width:{{ p.cand_w }};border-radius:2px;background:#0053b3;"></div></div></div>
            <div style="flex:1;"><div style="display:flex;justify-content:space-between;font-size:11px;color:#7c8374;"><span>prontidão</span><span class="mono" style="color:#e8730c;font-weight:600;">{{ p.ready }}</span></div>
              <div style="margin-top:3px;height:4px;border-radius:2px;background:#eef0ea;"><div style="height:100%;width:{{ p.ready_w }};border-radius:2px;background:#e8730c;"></div></div></div>
          </div>
          <div style="margin-top:9px;font-size:12px;color:#4b5159;"><b style="color:{{ p.color }};">{{ p.rec_label }}</b> — {{ p.note }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.diff_events or r.previous_results or r.lifecycle_lead_times %}
    <!-- CICLO FECHADO MVP 3 -->
    <div class="sec" style="margin-top:44px;"><span class="n mono" style="color:#0053b3;">↻</span><h2>Ciclo fechado e benefício realizado</h2></div>
    <p class="lead">Acompanhamento da decisão até a validação, com comparação temporal e economia medida.</p>
    <div style="margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
      <div style="border:1px solid #e2e4dc;border-radius:10px;padding:14px 16px;"><div class="kicker">Economia comprometida</div><div class="mono" style="margin-top:7px;font-size:20px;color:#0053b3;font-weight:600;">{{ r.committed_fmt }}/mês</div></div>
      <div style="border:1px solid #e2e4dc;border-radius:10px;padding:14px 16px;"><div class="kicker">Economia realizada</div><div class="mono" style="margin-top:7px;font-size:20px;color:#e8730c;font-weight:600;">{{ r.realized_fmt }}/mês</div></div>
      <div style="border:1px solid #e2e4dc;border-radius:10px;padding:14px 16px;"><div class="kicker">Taxa de realização</div><div class="mono" style="margin-top:7px;font-size:20px;color:#12233f;font-weight:600;">{{ r.realization_rate_pct }}</div></div>
    </div>
    {% if r.lifecycle_lead_times %}
    <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap;">
      {% for lead in r.lifecycle_lead_times %}<span class="chip mono" style="color:#0053b3;background:#e6effa;">{{ lead.label }} · {{ lead.days }} dias</span>{% endfor %}
    </div>
    {% endif %}
    {% if r.diff_events %}
    <div style="margin-top:18px;border:1px solid #e2e4dc;border-radius:10px;padding:14px 16px;">
      <div class="kicker" style="margin-bottom:10px;">Mudanças desde o último scan</div>
      {% for event in r.diff_events %}
      <div style="display:flex;justify-content:space-between;gap:14px;padding:7px 0;border-top:1px dotted #e2e4dc;font-size:12.5px;"><span><b>{{ event.type }}</b> · {{ event.asset }}</span><span class="mono" style="color:#7c8374;">{{ event.rule_id }}</span></div>
      {% endfor %}
    </div>
    {% endif %}
    {% endif %}

    {% if r.previous_results %}
    <!-- 07 RESULTADOS ANTERIORES -->
    <div class="sec" style="margin-top:44px;"><span class="n mono" style="color:#e8730c;">07</span><h2>Resultado das recomendações anteriores</h2></div>
    <p class="lead">Ganho realizado × previsto — não só o total, mas o custo por unidade. Estes valores calibram as regras de estimativa.</p>
    <div style="margin-top:18px;border:1px solid #e2e4dc;border-radius:12px;overflow:hidden;">
      <div style="display:grid;grid-template-columns:1.4fr 96px 96px 84px 1fr;background:#f3f4ee;font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;font-weight:600;color:#7c8374;">
        <div style="padding:11px 16px;">Recomendação implementada</div><div style="padding:11px 12px;text-align:right;">Prevista</div><div style="padding:11px 12px;text-align:right;">Realizada</div><div style="padding:11px 12px;text-align:center;">Precisão</div><div style="padding:11px 16px;">Custo por unidade</div>
      </div>
      {% for r2 in r.previous_results %}
      <div style="display:grid;grid-template-columns:1.4fr 96px 96px 84px 1fr;border-top:1px solid #edeee8;align-items:center;">
        <div style="padding:14px 16px;"><div style="font-size:13.5px;font-weight:600;color:#12233f;">{{ r2.title }}</div><div class="mono" style="margin-top:3px;font-size:11px;color:#7c8374;">{{ r2.asset }} · impl. {{ r2.date }}</div></div>
        <div class="mono" style="padding:14px 12px;text-align:right;font-size:13px;color:#5b6169;">{{ r2.predicted_fmt }}</div>
        <div class="mono" style="padding:14px 12px;text-align:right;font-size:13px;font-weight:600;color:#e8730c;">{{ r2.realized_fmt }}</div>
        <div style="padding:14px 12px;text-align:center;"><span class="chip mono" style="color:{{ r2.prec_fg }};background:{{ r2.prec_bg }};">{{ r2.precision }}%</span></div>
        <div style="padding:14px 16px;font-size:12.5px;color:#4b5159;line-height:1.4;">{{ r2.unit }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

      </div>
    </details>

    <!-- RUN MANIFEST -->
    <div style="margin-top:44px;border-top:1px solid #e2e4dc;padding-top:22px;">
      <div class="kicker" style="margin-bottom:12px;">Run manifest — reprodutibilidade</div>
      <div class="mono" style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px 28px;font-size:11.5px;color:#5b6169;">
        {% for m in r.manifest %}<div style="display:flex;justify-content:space-between;gap:10px;border-bottom:1px dotted #e2e4dc;padding-bottom:6px;"><span style="color:#96a0b4;">{{ m.k }}</span><span style="color:#22262c;text-align:right;">{{ m.v }}</span></div>{% endfor %}
      </div>
